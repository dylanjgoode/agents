# WhatsApp Business Cloud API credentials from your Meta app.
# A permanent System User token, not the 24-hour token from API Setup.
WHATSAPP_ACCESS_TOKEN=
# App Settings > Basic > App Secret. Verifies X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# WhatsApp > API Setup > Phone Number ID (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string. Enter the same value as the webhook's Verify Token.
WHATSAPP_VERIFY_TOKEN=
# Optional. Graph API base URL. Leave unset to call https://graph.facebook.com.
WHATSAPP_API_URL=
# Optional. Name the bot uses in its own replies. Defaults to AtlasExplorer.
WHATSAPP_BOT_DISPLAY_NAME=

# Required comma-separated WhatsApp IDs allowed to use the shared Atlas
# identity: the phone number in international format, with the "whatsapp:"
# prefix. Spaces and a leading + are removed.
CHAT_ALLOWED_USER_IDS=whatsapp:15550001111

# Agent Engine invocation target. Keep "gateway" for a deployed workspace. For a
# fully local agent, set "local" and use http://localhost:3000 as the base URL;
# the service-account credentials and project/workspace IDs can then remain
# empty.
AGENTIC_INVOKE_TARGET=gateway
AGENTIC_BASE_URL=
AGENTIC_SA_CLIENT_ID=
AGENTIC_SA_CLIENT_SECRET=
AGENTIC_PROJECT_ID=
AGENTIC_WORKSPACE_ID=

# Optional. Most agent sessions allowed to be active in any rolling hour,
# across all users. Defaults to 40. See the Slack bot README's Session limit.
SESSION_LIMIT_PER_HOUR=
# Optional. Match the Agent Engine sandbox idle TTL. Defaults to 600.
SESSION_IDLE_TTL_SECONDS=

# Required for Vercel. `pnpm start` starts an ephemeral in-memory MongoDB
# server when this is blank.
MONGODB_URI=
THREAD_STORE_DB=atlas_explorer_whatsapp

# Optional. Port for `pnpm start`. Defaults to 3001.
PORT=
