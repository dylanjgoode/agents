# Copy this file to .env before running `agentic dev up` or `npm run dev`.
# `agent.yaml` owns app metadata, feature flags, and optional model hints.
# `.env` should only contain local secrets and environment-specific endpoints.

# MongoDB connection used by Magenta for LangGraph checkpoints and traces.
# Leave empty for local `agentic dev`; the CLI provides its local MongoDB URI.
MONGODB_URI=

# Runtime database for checkpoints and traces.
MDB_AGENTIC_STORE_DB=mdb_store_agent_atlas_explorer_local

# Atlas Admin API credentials. Each AER/Tool Pod process uses these to create
# its own Managed MCP service identity at startup; the native MCP client then
# obtains short-lived OAuth tokens. Use Atlas programmatic API keys with
# permission to create organization MCP configs.
ATLAS_ORG_ID=
ATLAS_PUBLIC_API_KEY=
ATLAS_PRIVATE_API_KEY=

# ATLAS_MCP_CLIENT_ID and ATLAS_MCP_CLIENT_SECRET are generated in memory.
# Do not set or persist them here.

# LLM credentials. Set the key matching config.provider in agent.yaml (or the
# only key present).

# Anthropic API key (config.provider: anthropic).
ANTHROPIC_API_KEY=
# Optional Anthropic-compatible base URL (e.g. Grove Foundry).
ANTHROPIC_BASE_URL=

# Google Gemini API key (config.provider: gemini).
GEMINI_API_KEY=

# OpenAI or OpenAI-compatible API key (config.provider: openai).
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (e.g. Grove Foundry, Azure OpenAI).
OPENAI_BASE_URL=
# Required when OPENAI_BASE_URL targets Azure OpenAI.
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# auto (default), true, or false. Reasoning models use Responses by default.
OPENAI_USE_RESPONSES_API=auto

# Cerebras API key (config.provider: cerebras).
CEREBRAS_API_KEY=
