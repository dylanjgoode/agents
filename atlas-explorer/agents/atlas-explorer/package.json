    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.7",
    "@magenta/magenta-sdklanggraph-ts": "git+https://github.com/10gen/magenta-client-libraries.git#path:packages/magenta-sdklanggraph-ts",
    "@magenta/runner-shared-ts": "git+https://github.com/10gen/magenta-client-libraries.git#path:packages/runner-shared-ts",
    "@magenta/sdk-core-ts": "git+https://github.com/10gen/magenta-client-libraries.git#path:packages/sdk-core-ts",
    "dotenv": "^16.4.5",
    "mongodb": "^6.0.0",
    "zod": "^4.4.3"
