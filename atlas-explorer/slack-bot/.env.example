# Slack credentials for both local Socket Mode and Vercel HTTP mode.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Required only for local Socket Mode. Create an app-level token with
# connections:write.
SLACK_APP_TOKEN=
SLACK_BOT_DISPLAY_NAME=AtlasExplorer
# Required comma-separated Slack member IDs allowed to use the shared Atlas
# identity.
SLACK_ALLOWED_USER_IDS=

# Magenta invocation target. Keep "gateway" for a deployed workspace. For a
# fully local agent, set "local" and use http://localhost:3000 as the base URL;
# the API key and project/workspace IDs can then remain empty.
AGENTIC_INVOKE_TARGET=gateway
# Optional; defaults to the platform gateway or local Playground for the
# selected target.
AGENTIC_BASE_URL=
AGENTIC_API_KEY=
AGENTIC_PROJECT_ID=
AGENTIC_WORKSPACE_ID=

# Required for Vercel. Local Socket Mode falls back to an in-memory store.
MONGODB_URI=
THREAD_STORE_DB=atlas_explorer_slack
