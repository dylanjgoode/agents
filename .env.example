# Atlas Admin API (required)
ORG_ID=
PUBLIC_API_KEY="abcdef"
PRIVATE_API_KEY="123q4b30-...-4caa"

# LLM Configuration (at least one provider key required)
# -------------------------------------------------------------
# Option A: OpenAI / OpenAI-compatible (default)
OPENAI_API_KEY=
# Optional base URL (e.g., custom gateway, vLLM, Ollama, etc.)
OPENAI_BASE_URL=
# auto uses Responses for GPT-5/o-series; set true/false for gateway compatibility
OPENAI_USE_RESPONSES_API=auto
# Model name/id (defaults to gpt-4o if unset)
MODEL=

# Option B: Dedicated Azure OpenAI client (AzureChatOpenAI)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_BASE_PATH=

# Option C: Anthropic (ChatAnthropic)
ANTHROPIC_API_KEY=
# Optional base URL (e.g., custom proxy / gateway)
ANTHROPIC_BASE_URL=
